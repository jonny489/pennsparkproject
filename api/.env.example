# Copy to api/.env and fill in. api/.env is gitignored — never commit real values.

# Supabase Postgres connection string (Project Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Signs access tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Google OAuth client (Google Cloud Console > Credentials > OAuth 2.0 Client ID).
# The redirect URI below must be registered there verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Where the browser is sent after a successful Google sign-in.
FRONTEND_URL=http://localhost:3000

# Browser origins allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:3000
