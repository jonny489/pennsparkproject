# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project URL and ANON key (Project Settings > API).
# Only the anon/publishable key belongs here — it ships to the browser.
# Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI service (Render/Railway in production).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000